<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="coo_reports_10xe.OrganizationNode">
        <div class="coo_org_branch">
            <div class="coo_org_person">
                <button t-if="props.node.children.length"
                        type="button"
                        class="coo_org_toggle"
                        t-att-title="state.expanded ? 'Collapse team' : 'Expand team'"
                        t-on-click="toggle">
                    <i t-attf-class="fa {{ state.expanded ? 'fa-minus-square-o' : 'fa-plus-square-o' }}"/>
                </button>
                <span t-else="" class="coo_org_toggle_placeholder"/>
                <span class="coo_org_avatar" t-esc="props.node.initials"/>
                <span class="coo_org_identity">
                    <strong t-esc="props.node.name"/>
                    <small>
                        <t t-esc="props.node.designation || 'No designation'"/>
                        <t t-if="props.node.department"> · <t t-esc="props.node.department"/></t>
                    </small>
                </span>
                <span t-if="props.node.code" class="coo_org_code">#<t t-esc="props.node.code"/></span>
                <span t-if="props.node.email" class="coo_org_email" t-esc="props.node.email"/>
                <span t-if="props.node.children.length" class="coo_org_team_count">
                    <t t-esc="props.node.children.length"/>
                    <t t-esc="props.node.children.length === 1 ? ' report' : ' reports'"/>
                </span>
            </div>
            <div t-if="props.node.children.length &amp;&amp; state.expanded" class="coo_org_children">
                <OrganizationNode t-foreach="props.node.children"
                                  t-as="child"
                                  t-key="child.id"
                                  node="child"/>
            </div>
        </div>
    </t>

    <t t-name="coo_reports_10xe.CooReportsDashboard">
        <div class="coo_report_page">
            <div class="coo_report_shell">
                <t t-if="state.view === 'index'">
                    <header class="coo_page_header">
                        <div>
                            <h1>COO Reports</h1>
                            <p>Select a report to view or export.</p>
                        </div>
                        <label class="coo_search">
                            <i class="fa fa-search"/>
                            <input type="search"
                                   placeholder="Search reports"
                                   t-att-value="state.query"
                                   t-on-input="onSearch"/>
                        </label>
                    </header>

                    <main class="coo_module_list">
                        <section t-foreach="visibleModules"
                                 t-as="module"
                                 t-key="module.key"
                                 class="coo_module">
                            <div class="coo_module_heading">
                                <div>
                                    <h2 t-esc="module.name"/>
                                    <p t-esc="module.description"/>
                                </div>
                                <span><t t-esc="module.reports.length"/> reports</span>
                            </div>
                            <div class="coo_report_rows">
                                <button t-foreach="module.reports"
                                        t-as="report"
                                        t-key="report.name"
                                        type="button"
                                        class="coo_report_row"
                                        t-att-disabled="state.busyKey"
                                        t-on-click="() => this.openReport(report)">
                                    <span class="coo_report_name">
                                        <strong t-esc="report.name"/>
                                        <small t-if="report.sensitive"><i class="fa fa-lock"/> Sensitive</small>
                                    </span>
                                    <span class="coo_report_format" t-esc="report.format"/>
                                    <span class="coo_report_action">
                                        <i t-if="state.busyKey === report.action"
                                           class="fa fa-spinner fa-spin"/>
                                        <t t-else="" t-esc="reportButtonText(report)"/>
                                    </span>
                                </button>
                            </div>
                        </section>

                        <div t-if="!visibleModules.length" class="coo_empty">
                            No reports match your search.
                        </div>
                    </main>
                </t>

                <t t-else="">
                    <header class="coo_viewer_header">
                        <button type="button" class="btn btn-light" t-on-click="backToReports">
                            <i class="fa fa-arrow-left"/> Back to reports
                        </button>
                        <button type="button"
                                class="btn btn-primary"
                                t-att-disabled="state.busyKey || (state.employeeReportKey === 'experience' &amp;&amp; !state.selectedId)"
                                t-on-click="exportEmployeeReport">
                            <i t-attf-class="fa {{ state.busyKey === 'employee-export' ? 'fa-spinner fa-spin' : 'fa-download' }}"/>
                            Export XLSX
                        </button>
                    </header>

                    <div t-if="state.busyKey &amp;&amp; !state.reportData" class="coo_loading">
                        <i class="fa fa-spinner fa-spin"/> Loading report...
                    </div>

                    <main t-if="state.reportData" class="coo_viewer">
                        <div class="coo_viewer_title">
                            <div>
                                <h1 t-esc="state.reportData.title"/>
                                <p t-esc="state.reportData.description"/>
                            </div>
                            <div t-if="state.reportData.selector" class="coo_selector">
                                <label t-if="state.reportData.selector === 'employee'" class="coo_selector_field">
                                    <span>Search active employees</span>
                                    <span class="coo_selector_input">
                                        <i class="fa fa-search"/>
                                        <input type="search"
                                               placeholder="Name, code, or work email"
                                               t-att-value="state.employeeSearch"
                                               t-on-input="onEmployeeSearch"/>
                                    </span>
                                </label>
                                <label class="coo_selector_field">
                                    <span t-esc="state.reportData.selector === 'employee' ? 'Employee' : 'Manager'"/>
                                    <select t-on-change="onSelectorChange">
                                        <option value="">
                                            <t t-esc="state.reportData.selector === 'employee' ? 'Select an active employee' : 'All active managers'"/>
                                        </option>
                                        <option t-foreach="filteredSelectorOptions"
                                                t-as="option"
                                                t-key="option.id"
                                                t-att-value="option.id"
                                                t-att-selected="option.id === state.selectedId"
                                                t-esc="option.label"/>
                                    </select>
                                </label>
                            </div>
                        </div>

                        <div t-if="state.reportData.selector === 'employee' &amp;&amp; !state.selectedId"
                             class="coo_prompt">
                            <t t-if="state.employeeSearch &amp;&amp; !filteredSelectorOptions.length">
                                No active employees match your search.
                            </t>
                            <t t-else="">Search for and select an active employee to view the report.</t>
                        </div>

                        <section t-if="state.employeeReportKey === 'organization'" class="coo_org_section">
                            <div class="coo_table_heading">
                                <h2>Active employee hierarchy</h2>
                                <span><t t-esc="state.reportData.employee_count"/> active employees</span>
                            </div>
                            <div class="coo_org_tree">
                                <OrganizationNode t-foreach="state.reportData.organization_tree"
                                                  t-as="rootNode"
                                                  t-key="rootNode.id"
                                                  node="rootNode"/>
                            </div>
                        </section>

                        <section t-foreach="state.reportData.sections"
                                 t-as="section"
                                 t-key="section.title"
                                 class="coo_table_section">
                            <div class="coo_table_heading">
                                <h2 t-esc="section.title"/>
                                <span><t t-esc="section.rows.length"/> rows</span>
                            </div>
                            <div class="coo_table_wrap">
                                <table class="table table-sm table-hover">
                                    <thead>
                                        <tr>
                                            <th t-foreach="section.columns"
                                                t-as="column"
                                                t-key="column.key"
                                                t-esc="column.label"/>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="section.rows" t-as="row" t-key="row_index">
                                            <td t-foreach="section.columns"
                                                t-as="column"
                                                t-key="column.key"
                                                t-esc="row[column.key]"/>
                                        </tr>
                                        <tr t-if="!section.rows.length">
                                            <td t-att-colspan="section.columns.length" class="coo_no_rows">No records found.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    </main>
                </t>
            </div>
        </div>
    </t>
</templates>
