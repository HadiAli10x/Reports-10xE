    <record id="view_coo_assignments_report_wizard_form" model="ir.ui.view">
        <field name="name">coo.assignments.report.wizard.form</field>
        <field name="model">coo.assignments.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Assignments Report">
                <sheet>
                    <div class="oe_title">
                        <h1>Assignments Report</h1>
                        <p>Export assignment allocations overlapping the selected reporting period.</p>
                    </div>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="include_drafts"/>
                            <field name="active_employees_only"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

