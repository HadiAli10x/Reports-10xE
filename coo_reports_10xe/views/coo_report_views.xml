<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coo_org_chart_report_wizard_form" model="ir.ui.view">
        <field name="name">coo.org.chart.report.wizard.form</field>
        <field name="model">coo.org.chart.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Organization Chart">
                <sheet>
                    <div class="oe_title">
                        <h1>Organization Chart</h1>
                        <p>Export the active reporting hierarchy for the whole company or a selected branch.</p>
                    </div>
                    <group>
                        <field name="root_employee_id" options="{'no_create': True}"/>
                        <field name="department_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_coo_org_chart_report" model="ir.actions.act_window">
        <field name="name">Organization Chart</field>
        <field name="res_model">coo.org.chart.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="coo_reports_10xe.view_coo_org_chart_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="view_coo_employee_experience_report_wizard_form" model="ir.ui.view">
        <field name="name">coo.employee.experience.report.wizard.form</field>
        <field name="model">coo.employee.experience.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Single Employee Experience">
                <sheet>
                    <div class="oe_title">
                        <h1>Single Employee Experience</h1>
                        <p>Export the current experience summary and appraisal history for one active employee.</p>
                    </div>
                    <group>
                        <field name="employee_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

